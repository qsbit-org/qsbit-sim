digraph architecture {
  graph [rankdir=TB, newrank=true, bgcolor="transparent", pad=0.2, nodesep=0.25, ranksep=0.45, compound=true];
  node [shape=box, style="rounded,filled", fillcolor="#edf6f7", color="#43818a", fontname="sans-serif", fontsize=14, margin="0.12,0.08", target="_top"];
  edge [color="#607a83", fontname="sans-serif", fontsize=11];
  subgraph cluster_setup { label="Platform and program setup"; color="#bacdd2"; style="rounded";
    m0 [label="Platform Configuration\nand Clock Adapter", href="modules/platform-and-clock-adapter.html", id="module-platform-and-clock-adapter"];
    m1 [label="ELF Loader and Program\nImage", href="modules/elf-loader-and-program-image.html", id="module-elf-loader-and-program-image"];
  }
  subgraph cluster_cpu { label="CPU domain: CpuCycleModel / TimelineProducer"; color="#bacdd2"; style="rounded";
    m2 [label="ISA Decoder and Semantics", href="modules/isa-decoder-and-semantics.html", id="module-isa-decoder-and-semantics"];
    m3 [label="CPU Cycle Model", href="modules/cpu-cycle-model.html", id="module-cpu-cycle-model"];
    m4 [label="Memory and Response Model", href="modules/memory-and-response-model.html", id="module-memory-and-response-model"];
    m5 [label="Quantum Instruction\nAdapter", href="modules/quantum-instruction-adapter.html", id="module-quantum-instruction-adapter"];
    m13 [label="Port Codeword and\nWaveform Map", href="modules/port-codeword-and-waveform-map.html", id="module-port-codeword-and-waveform-map"];
    m6 [label="Operation Lowerer and\nDevice Distributor", href="modules/operation-lowerer-and-device-distributor.html", id="module-operation-lowerer-and-device-distributor"];
    m7 [label="Timeline Reservation\nManager", href="modules/timeline-reservation-manager.html", id="module-timeline-reservation-manager"];
    m17 [label="Measurement Scoreboard\nand CPU Feedback", href="modules/measurement-scoreboard-and-cpu-feedback.html", id="module-measurement-scoreboard-and-cpu-feedback"];
  }
  subgraph cluster_tcu { label="TCU domain: TcuCycleModel"; color="#bacdd2"; style="rounded";
    m8 [label="Command Crossing and\nAtomic Admission", href="modules/command-crossing-and-admission.html", id="module-command-crossing-and-admission"];
    m9 [label="Timing Queue", href="modules/timing-queue.html", id="module-timing-queue"];
    m10 [label="Per-Port Event Queues", href="modules/per-port-event-queues.html", id="module-per-port-event-queues"];
    m11 [label="TCU Timer and Label\nBroadcaster", href="modules/tcu-timer-and-label-broadcaster.html", id="module-tcu-timer-and-label-broadcaster"];
    m12 [label="Condition Gate and Launch\nPreflight", href="modules/condition-gate-and-launch-preflight.html", id="module-condition-gate-and-launch-preflight"];
    m18 [label="Fast-Condition History", href="modules/fast-condition-history.html", id="module-fast-condition-history"];
  }
  subgraph cluster_device { label="Physical boundaries: DeviceRuntime"; color="#bacdd2"; style="rounded";
    m14 [label="Output Channels and\nResource Calendar", href="modules/output-channels-and-resource-calendar.html", id="module-output-channels-and-resource-calendar"];
    m15 [label="Quantum-State Service and\nBackends", href="modules/quantum-state-service-and-backends.html", id="module-quantum-state-service-and-backends"];
    m16 [label="Acquisition and\nDiscrimination", href="modules/acquisition-and-discrimination.html", id="module-acquisition-and-discrimination"];
  }
  subgraph cluster_lifecycle { label="Observation and extension boundary"; color="#bacdd2"; style="rounded";
    m19 [label="Trace Recorder and Stop\nController", href="modules/trace-recorder-and-stop-controller.html", id="module-trace-recorder-and-stop-controller"];
    m20 [label="Synchronization Extension\nBoundary", href="modules/future-synchronization-adapter.html", id="module-future-synchronization-adapter"];
  }
  m1 -> m4 [label="ProgramImage"];
  m4 -> m3 [constraint=false, label="MemoryResponse"];
  m3 -> m4 [label="MemoryRequest"];
  m2 -> m3 [label="Decoded / Effect"];
  m3 -> m5 [label="decoded instruction"];
  m5 -> m7 [label="ProducerOperation"];
  m13 -> m6 [label="Mapping"];
  m6 -> m7 [label="ReservedEvent"];
  m7 -> m8 [label="Group mailbox"];
  m8 -> m7 [constraint=false, label="GroupReply mailbox"];
  m8 -> m9 [label="TimingPoint"];
  m8 -> m10 [label="ReservedEvent"];
  m9 -> m11 [label="due head"];
  m11 -> m10 [label="due label"];
  m10 -> m12 [label="manifested members"];
  m18 -> m12 [label="old history"];
  m12 -> m14 [label="LaunchBatch / preflight"];
  m14 -> m15 [label="physical actions"];
  m15 -> m16 [label="sample bits"];
  m16 -> m17 [constraint=false, label="Completion / CPU mailbox"];
  m16 -> m18 [constraint=false, label="Completion / fast mailbox"];
  m17 -> m7 [constraint=false, label="visible result / token"];
  m5 -> m20 [label="QSYNC"];
  m0 -> m3 [style=dashed, constraint=false, label="activation"];
  m0 -> m11 [style=dashed, constraint=false, label="activation"];
  m0 -> m14 [style=dashed, constraint=false, label="activation"];
  m3 -> m19 [style=dashed, constraint=false, label="TraceEvent"];
  m11 -> m19 [style=dashed, constraint=false, label="TraceEvent"];
  m14 -> m19 [style=dashed, constraint=false, label="TraceEvent"];
}
