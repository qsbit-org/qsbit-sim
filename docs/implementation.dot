digraph implementation {
  graph [rankdir=TB, newrank=true, bgcolor="transparent", pad=0.2, nodesep=0.25, ranksep=0.45, compound=true];
  node [shape=box, style="rounded,filled", fillcolor="#edf6f7", color="#43818a", fontname="sans-serif", fontsize=14, margin="0.12,0.08", target="_top"];
  edge [color="#607a83", fontname="sans-serif", fontsize=11];
  subgraph cluster_setup { label="Platform and program setup"; color="#bacdd2"; style="rounded";
    m0 [label="Platform and clocks", href="modules/platform-and-clock-adapter.html", id="module-platform-and-clock-adapter"];
    m1 [label="ELF Loader and Program\nImage", href="modules/elf-loader-and-program-image.html", id="module-elf-loader-and-program-image"];
  }
  subgraph cluster_cpu { label="CPU domain: CpuCycleModel and TimingControl"; color="#bacdd2"; style="rounded";
    m2 [label="ISA Decoder and Semantics", href="modules/isa-decoder-and-semantics.html", id="module-isa-decoder-and-semantics"];
    m3 [label="CPU Cycle Model", href="modules/cpu-cycle-model.html", id="module-cpu-cycle-model"];
    m4 [label="Memory requests and responses", href="modules/memory-and-response-model.html", id="module-memory-and-response-model"];
    m5 [label="Quantum Instruction\nAdapter", href="modules/quantum-instruction-adapter.html", id="module-quantum-instruction-adapter"];
    m13 [label="Port and codeword map", href="modules/port-codeword-and-waveform-map.html", id="module-port-codeword-and-waveform-map"];
    m6 [label="Codeword decoding", href="modules/codeword-decoding.html", id="module-codeword-decoding"];
    m7 [label="Reserve phase\nTimingControl", href="modules/reserve-phase.html", id="module-reserve-phase"];
    m17 [label="MeasurementResults\nCPU result storage", href="modules/measurement-results.html", id="module-measurement-results"];
  }
  subgraph cluster_tcu { label="TCU domain: TcuCycleModel"; color="#bacdd2"; style="rounded";
    m8 [label="Queue insertion\nand communication latency", href="modules/queue-enqueue.html", id="module-queue-enqueue"];
    m9 [label="Timing Queue", href="modules/timing-queue.html", id="module-timing-queue"];
    m10 [label="Per-Port Event Queues", href="modules/per-port-event-queues.html", id="module-per-port-event-queues"];
    m11 [label="Timing controller\nand event trigger", href="modules/timing-controller.html", id="module-timing-controller"];
    m12 [label="Conditional execution\nand event validation", href="modules/conditional-execution.html", id="module-conditional-execution"];
    m18 [label="ConditionalResults", href="modules/conditional-results.html", id="module-conditional-results"];
  }
  subgraph cluster_device { label="ControlElectronics: scheduled simulation events"; color="#bacdd2"; style="rounded";
    m14 [label="Control output\nand resource checks", href="modules/control-output.html", id="module-control-output"];
    m15 [label="Quantum\nBackends", href="modules/quantum-device-model.html", id="module-quantum-device-model"];
    m16 [label="Acquisition and\nDiscrimination", href="modules/acquisition-and-discrimination.html", id="module-acquisition-and-discrimination"];
  }
  subgraph cluster_lifecycle { label="Tracing and completion"; color="#bacdd2"; style="rounded";
    m19 [label="Tracing and completion", href="modules/trace-recorder-and-stop-controller.html", id="module-trace-recorder-and-stop-controller"];
    m20 [label="QSYNC\nUnsupported synchronization", href="modules/future-synchronization-adapter.html", id="module-future-synchronization-adapter"];
  }
  m1 -> m4 [label="ProgramImage"];
  m4 -> m3 [constraint=false, label="MemoryResponse"];
  m3 -> m4 [label="MemoryRequest"];
  m2 -> m3 [label="Decoded and Effect"];
  m3 -> m5 [label="decoded instruction"];
  m5 -> m7 [label="ControlOperation"];
  m13 -> m6 [label="Mapping"];
  m6 -> m7 [label="OperationEvent"];
  m7 -> m8 [label="TimingEvents mailbox"];
  m8 -> m7 [constraint=false, label="EnqueueReply mailbox"];
  m8 -> m9 [label="TimingPoint"];
  m8 -> m10 [label="OperationEvent"];
  m9 -> m11 [label="due head"];
  m11 -> m10 [label="due label"];
  m10 -> m12 [label="associated events"];
  m18 -> m12 [label="history from earlier edges"];
  m12 -> m14 [label="TriggeredEvents and preflight"];
  m14 -> m15 [label="scheduled events"];
  m15 -> m16 [label="sample bits"];
  m16 -> m17 [constraint=false, label="Completion and CPU mailbox"];
  m16 -> m18 [constraint=false, label="Completion and fast mailbox"];
  m17 -> m7 [constraint=false, label="measurement reference"];
  m5 -> m20 [label="QSYNC"];
  m0 -> m3 [style=dashed, constraint=false, label="activation"];
  m0 -> m11 [style=dashed, constraint=false, label="activation"];
  m0 -> m14 [style=dashed, constraint=false, label="activation"];
  m3 -> m19 [style=dashed, constraint=false, label="TraceEvent"];
  m11 -> m19 [style=dashed, constraint=false, label="TraceEvent"];
  m14 -> m19 [style=dashed, constraint=false, label="TraceEvent"];
}
