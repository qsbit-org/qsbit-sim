{% set compiler, version, executable = detect_api.detect_clang_compiler() %}
[settings]
os=Linux
arch={{ detect_api.detect_arch() }}
compiler={{ compiler }}
compiler.version={{ version.major }}
compiler.libcxx=libstdc++11
compiler.cppstd=20
build_type=Debug

[conf]
tools.build:compiler_executables={"c": "clang", "cpp": "clang++", "asm": "clang"}
tools.cmake.cmaketoolchain:generator=Ninja
