{% set compiler, version, executable = detect_api.detect_clang_compiler() %}
[settings]
os={{ detect_api.detect_os() }}
arch={{ detect_api.detect_arch() }}
compiler={{ compiler }}
compiler.version={{ detect_api.default_compiler_version(compiler, version) }}
compiler.libcxx={{ "libc++" if compiler == "apple-clang" else "libstdc++11" }}
compiler.cppstd=20
build_type=Debug

[conf]
tools.build:compiler_executables={"c": "clang", "cpp": "clang++", "asm": "clang"}
tools.cmake.cmaketoolchain:generator=Ninja
