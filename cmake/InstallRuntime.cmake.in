# Install only native resources; Python environments are managed by the caller.
set(runtime_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@/qsbit-sim")
file(MAKE_DIRECTORY "${runtime_root}")
file(WRITE "${runtime_root}/runtime.json"
  "{\"schema\":1,\"version\":\"@PROJECT_VERSION@\",\"revision\":\"@QSBIT_RUNTIME_REVISION@\",\"python_enabled\":@QSBIT_RUNTIME_PYTHON_JSON@}\n")
